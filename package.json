{
  "name": "jsonl-viewer",
  "displayName": "JSONL Viewer",
  "description": "High-performance viewer for .jsonl / .ndjson / .jsonlines files: record list + collapsible JSON tree detail, lazy indexing & on-demand parsing for multi-GB files.",
  "version": "1.11.1",
  "publisher": "jsonl-viewer",
  "license": "ISC",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1f3a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GaussAA/jsonl-viewer"
  },
  "keywords": [
    "jsonl",
    "ndjson",
    "jsonlines",
    "viewer",
    "webview",
    "big-file",
    "lazy-loading",
    "vscode-extension"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.18"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:jsonlViewer.open",
    "onCustomEditor:jsonlViewer.customEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jsonlViewer.open",
        "title": "JSONL Viewer: Open as JSONL Viewer",
        "category": "JSONL Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "jsonlViewer.customEditor",
        "displayName": "JSONL Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonlines"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "jsonlViewer.open",
          "when": "resourceExtname =~ /\\.(jsonl|ndjson|jsonlines)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "JSONL Viewer",
      "properties": {
        "jsonlViewer.sampleLines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Number of leading lines sampled for field inference and summary cards. Larger files keep scanning to a minimum."
        },
        "jsonlViewer.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose host logging to the 'JSONL Viewer' output channel (index build progress, message flow). Useful for troubleshooting."
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build": "node build.mjs --minify",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts build.mjs",
    "lint:ci": "oxlint src scripts build.mjs --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/register-loaders.mjs --experimental-transform-types --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import ./scripts/register-loaders.mjs --experimental-transform-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test \"src/**/*.test.ts\"",
    "test:coverage:gate": "node --import ./scripts/register-loaders.mjs --experimental-transform-types --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=96 --test-coverage-branches=86 --test-coverage-functions=88 --test \"src/**/*.test.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "integration": "node scripts/test-integration.mjs",
    "release": "node scripts/release.mjs",
    "vsix": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "oxlint": "^1.88.0",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
