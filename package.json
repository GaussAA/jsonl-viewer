{
  "name": "jsonl-viewer",
  "displayName": "JSONL Viewer",
  "description": "High-performance viewer for .jsonl / .ndjson / .jsonlines files: record list + collapsible JSON tree detail, lazy indexing & on-demand parsing for multi-GB files.",
  "version": "1.5.1",
  "publisher": "jsonl-viewer",
  "license": "ISC",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1f3a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GaussAA/jsonl-viewer"
  },
  "keywords": [
    "jsonl",
    "ndjson",
    "jsonlines",
    "viewer",
    "webview",
    "big-file",
    "lazy-loading",
    "vscode-extension"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.18"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:jsonlViewer.open",
    "onCustomEditor:jsonlViewer.customEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jsonlViewer.open",
        "title": "JSONL Viewer: Open as JSONL Viewer",
        "category": "JSONL Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "jsonlViewer.customEditor",
        "displayName": "JSONL Viewer",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          },
          {
            "filenamePattern": "*.jsonlines"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "jsonlViewer.open",
          "when": "resourceExtname =~ /\\.(jsonl|ndjson|jsonlines)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "JSONL Viewer",
      "properties": {
        "jsonlViewer.sampleLines": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Number of leading lines sampled for field inference and summary cards. Larger files keep scanning to a minimum."
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build": "node build.mjs --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node scripts/test-integration.mjs",
    "integration": "node scripts/test-integration.mjs",
    "release": "node scripts/release.mjs",
    "vsix": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
